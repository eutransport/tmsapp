# ===========================================
# TMS Configuratie Template
# ===========================================
# Dit bestand wordt automatisch ingevuld door
# het installatiescript (install.sh).
#
# Handmatig gebruiken:
#   cp .env.example .env
#   nano .env  (vul waardes in)
#   docker compose up -d
# ===========================================

# -----------------------------------------
# DOMEIN
# -----------------------------------------
# Je domeinnaam zonder https://
# Gebruik 'localhost' voor lokaal testen
DOMAIN_NAME=tms.example.com

# -----------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------
DB_NAME=tms_db
DB_USER=tms_user
# Genereer met: openssl rand -base64 24
DB_PASSWORD=WIJZIG_DIT_WACHTWOORD

# -----------------------------------------
# SECURITY
# -----------------------------------------
# Django secret key (verplicht)
# Genereer met: openssl rand -base64 64
SECRET_KEY=WIJZIG_DEZE_SECRET_KEY

# -----------------------------------------
# ADMIN ACCOUNT (eerste login)
# -----------------------------------------
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=WIJZIG_DIT_WACHTWOORD

# -----------------------------------------
# OPTIONEEL: EMAIL (SMTP)
# -----------------------------------------
# Alleen nodig voor wachtwoord reset emails
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=email_wachtwoord
# DEFAULT_FROM_EMAIL=TMS <noreply@example.com>

# -----------------------------------------
# OPTIONEEL: GEO-BLOKKERING (MaxMind GeoLite2)
# -----------------------------------------
# Nodig om het land van een bezoeker te bepalen. Zonder deze gegevens
# blijft de applicatie gewoon werken, maar blokkeert geo-blokkering niets.
# Gratis account: https://www.maxmind.com/en/geolite2/signup
# MAXMIND_ACCOUNT_ID=123456
# MAXMIND_LICENSE_KEY=jouw_licentiesleutel
# MAXMIND_EDITION_IDS=GeoLite2-Country
# Uren tussen automatische controles door de geoipupdate-service.
# MAXMIND_UPDATE_FREQUENCY=72
#
# Starten van de updater:  docker compose --profile geoip up -d geoipupdate
# Eenmalig handmatig:      docker compose exec backend python manage.py update_geoip_db
